# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# --- Google Maps (mapa dentro de la app) ---
# Google Cloud → habilita "Maps SDK for Android" y "Maps SDK for iOS".
GOOGLE_MAPS_API_KEY=
# Opcional: keys separadas por plataforma
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=

# --- Rutas reales desde tu posición (Directions API) ---
# Google Cloud → habilita "Directions API". Usa una key restringida a esa API.
# Sin esta key la app traza una ruta estimada (funciona sin internet).
EXPO_PUBLIC_GOOGLE_DIRECTIONS_KEY=

# --- Servidor de la comunidad (Supabase) ---
# supabase.com → tu proyecto → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Mapas sin conexión ---
# Plantilla de teselas {z}/{x}/{y}. Por defecto OpenTopoMap (uso moderado).
# Para producción usa un proveedor propio o comercial que permita descarga offline.
# EXPO_PUBLIC_OFFLINE_TILE_URL=https://tile.opentopomap.org/{z}/{x}/{y}.png
